{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Torrekie/Battman/schemas/plugin-trust-metadata-v1.json",
  "title": "Battman plug-in trust metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sequence",
    "generatedAtUnixSeconds",
    "officialPublishers",
    "revokedKeyIdentifiers"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "generatedAtUnixSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "officialPublishers": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyIdentifier",
          "publicKeyX963Base64",
          "pluginIdentifiers",
          "extensionPointIdentifiers"
        ],
        "properties": {
          "keyIdentifier": { "$ref": "#/$defs/keyIdentifier" },
          "publicKeyX963Base64": {
            "type": "string",
            "minLength": 88,
            "maxLength": 88
          },
          "pluginIdentifiers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" }
          },
          "extensionPointIdentifiers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" }
          }
        }
      }
    },
    "revokedKeyIdentifiers": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/keyIdentifier" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"
    },
    "keyIdentifier": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
