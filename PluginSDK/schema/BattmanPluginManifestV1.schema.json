{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Torrekie/Battman/schemas/plugin-manifest-v1.json",
  "title": "Battman plug-in manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "schemaVersion",
    "pluginIdentifier",
    "displayName",
    "displayVersion",
    "buildVersion",
    "publisher",
    "hostABI",
    "payload",
    "extensionPoints",
    "files",
    "dependencies",
    "releaseSequence"
  ],
  "properties": {
    "formatVersion": { "const": 1 },
    "schemaVersion": { "const": 1 },
    "pluginIdentifier": { "$ref": "#/$defs/identifier" },
    "displayName": { "$ref": "#/$defs/displayString" },
    "displayVersion": { "$ref": "#/$defs/versionString" },
    "buildVersion": { "$ref": "#/$defs/versionString" },
    "publisher": { "$ref": "#/$defs/publisher" },
    "author": { "$ref": "#/$defs/author" },
    "hostABI": { "$ref": "#/$defs/hostABI" },
    "payload": { "$ref": "#/$defs/payload" },
    "extensionPoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/extensionPoint" }
    },
    "files": {
      "type": "array",
      "minItems": 2,
      "maxItems": 502,
      "items": { "$ref": "#/$defs/file" }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "releaseSequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "authorizationReferences": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/authorizationReference" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"
    },
    "displayString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!.*[\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200e\\u200f\\u2028-\\u202e\\u2066-\\u2069])\\S(?:.*\\S)?$"
    },
    "versionString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "keyIdentifier": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primaryKeyIdentifier",
        "signatureKeyIdentifiers",
        "algorithm"
      ],
      "properties": {
        "primaryKeyIdentifier": { "$ref": "#/$defs/keyIdentifier" },
        "signatureKeyIdentifiers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/keyIdentifier" }
        },
        "algorithm": { "const": "ecdsa-p256-sha256" }
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!.*[\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200e\\u200f\\u2028-\\u202e\\u2066-\\u2069])\\S(?:.*\\S)?$"
        },
        "homepageURL": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^https://[^\\s]+$"
        },
        "supportEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254,
          "pattern": "^[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]+@[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$"
        }
      }
    },
    "hostABI": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "maximum": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "executablePath",
        "architecture",
        "minimumIOSVersion",
        "entryPoint"
      ],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "kind": { "enum": ["bundle", "so"] },
        "executablePath": { "$ref": "#/$defs/relativePath" },
        "architecture": { "const": "arm64" },
        "minimumIOSVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}$"
        },
        "entryPoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "codeIdentity": { "$ref": "#/$defs/codeIdentity" }
      }
    },
    "codeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "unsignedByteCount", "sha256"],
      "properties": {
        "algorithm": { "const": "macho-codesign-independent-sha256-v1" },
        "unsignedByteCount": {
          "type": "integer",
          "minimum": 32,
          "maximum": 67108864
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "extensionPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "interfaceVersion"],
      "properties": {
        "identifier": { "$ref": "#/$defs/identifier" },
        "interfaceVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "mode", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "mode": { "enum": ["data", "executable"] },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "authorizationReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identifier", "minimumSequence"],
      "properties": {
        "kind": { "enum": ["key-rotation", "catalog-delegation"] },
        "identifier": { "$ref": "#/$defs/identifier" },
        "minimumSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
