Package: @PACKAGE@
Name: Battman
Version: @VERSION@
Architecture: @ARCHITECTURE@
Section: Applications
Installed-Size: @INSTALLED_SIZE@
Depends: firmware (>= 12.0), cy+model.iphone (>= 10.1) | cy+model.ipad (>= 8.1), libintl8 | libintl
