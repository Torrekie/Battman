  "analyticsCards": [
    {
      "availability": "Each live metric is displayed independently; missing values remain unavailable. Net power uses the host-only signed reading when present, otherwise the labeled average. The short curve covers foreground samples only.",
      "delivery": "embedded",
      "hardwareBoundary": "host-snapshot-and-foreground-short-window-no-persistent-history",
      "identifier": "com.torrekie.battman.analytics.live",
      "requiredMetrics": [
        "battery.state-of-charge.percent",
        "battery.charging.state",
        "system.low-power-mode",
        "battery.power.net.watts",
        "battery.power.average.watts",
        "battery.current.average.milliamps",
        "battery.temperature.average.celsius"
      ]
    },
    {
      "availability": "Current FCC and design capacity are paired only from the same snapshot; otherwise validated historical observations are used. Ratios require a compatible design value. Missing history or source/configuration discontinuities remain explicit; FCC changes do not establish battery replacement.",
      "delivery": "embedded",
      "hardwareBoundary": "host-capacity-snapshot-or-host-only-normalized-powerlog-history",
      "identifier": "com.torrekie.battman.analytics.capacity",
      "requiredMetrics": [
        "battery.capacity.full-charge.milliamp-hours",
        "battery.capacity.design.milliamp-hours",
        "full-charge-capacity.milliamp-hours",
        "design-capacity.milliamp-hours",
        "cycle-count"
      ]
    },
    {
      "availability": "Displays validated main-battery cell channels independently, including additional discovered indices. Concurrent spread needs at least two valid channels from the same observation. When history is absent, validated live channels may be shown explicitly as current readings; they do not imply historical coverage. Missing channels remain unavailable; attachment-battery fields are not substituted.",
      "delivery": "embedded",
      "hardwareBoundary": "host-only-normalized-main-battery-cell-voltage-history-or-validated-live",
      "identifier": "com.torrekie.battman.analytics.cells",
      "requiredMetrics": [
        "cell-voltage.0.millivolts",
        "cell-voltage.1.millivolts",
        "cell-voltage.2.millivolts"
      ]
    },
    {
      "availability": "Requires an observed connected session. SOC, signed current and temperature tracks retain independent coverage; missing or unvalidated tracks remain unavailable. Sampled boundaries, pauses and gaps are shown without treating a connected cable as proof of charging.",
      "delivery": "embedded",
      "hardwareBoundary": "host-only-normalized-connected-powerlog-session",
      "identifier": "com.torrekie.battman.analytics.session",
      "requiredMetrics": [
        "soc.percent",
        "temperature.celsius",
        "current.milliamps",
        "external-connected",
        "is-charging",
        "fully-charged"
      ]
    },
    {
      "availability": "Requires an observed unplugged session. SOC decline and battery output use independently trusted coverage; unknown reconnection time and missing output remain explicit. Historical output magnitude does not infer an application-level energy cause.",
      "delivery": "embedded",
      "hardwareBoundary": "host-only-normalized-unplugged-powerlog-session",
      "identifier": "com.torrekie.battman.analytics.discharge",
      "requiredMetrics": [
        "soc.percent",
        "battery-power.watts",
        "external-connected"
      ]
    },
    {
      "availability": "Uses validated observed connection, charging and full states; unknown or conflicting state stays distinct. State duration is limited to trusted intervals, and transitions retain sampled time bounds. An absent reason code is not inferred.",
      "delivery": "embedded",
      "hardwareBoundary": "host-only-normalized-powerlog-states-and-sampled-transitions",
      "identifier": "com.torrekie.battman.analytics.events",
      "requiredMetrics": [
        "external-connected",
        "is-charging",
        "fully-charged",
        "not-charging-reason.code"
      ]
    },
    {
      "availability": "Input, battery net power, budget and target are independent measurement points with their own observation times. Unvalidated or absent input/target fields remain unavailable. Budget and target are not measured delivered power; no efficiency or loss is inferred by subtraction.",
      "delivery": "embedded",
      "hardwareBoundary": "host-only-normalized-powerlog-measurement-points-not-an-efficiency-model",
      "identifier": "com.torrekie.battman.analytics.path",
      "requiredMetrics": [
        "battery-power.watts",
        "input-power.watts",
        "power-budget.watts",
        "power-target.watts"
      ]
    },
    {
      "availability": "SOC bins require trusted adjacent samples; temperature bins additionally require jointly validated temperature. Missing time is excluded and disclosed. Connection states remain separate, and the distribution is not a battery damage or health score.",
      "delivery": "embedded",
      "hardwareBoundary": "host-only-normalized-powerlog-time-weighted-intervals",
      "identifier": "com.torrekie.battman.analytics.dwell",
      "requiredMetrics": [
        "soc.percent",
        "temperature.celsius",
        "external-connected"
      ]
    },
    {
      "availability": "Includes only compatible complete connected sessions with trusted upward 20-to-80 percent crossings. Partial, overlapping, duplicate or gapped sessions are excluded with reasons. Temperature peaks require validated samples in that same range and remain unavailable otherwise; small samples use individual points.",
      "delivery": "embedded",
      "hardwareBoundary": "host-only-compatible-complete-connected-powerlog-sessions",
      "identifier": "com.torrekie.battman.analytics.compare",
      "requiredMetrics": [
        "soc.percent",
        "external-connected",
        "temperature.celsius"
      ]
    },
    {
      "availability": "Uses signed observed SOC decline divided by valid unplugged duration. Missing or unknown hours, connected periods and measured zero remain distinct. Local calendar boundaries preserve daylight-saving changes; an observed SOC rise does not infer charging.",
      "delivery": "embedded",
      "hardwareBoundary": "host-only-normalized-unplugged-powerlog-calendar-intervals",
      "identifier": "com.torrekie.battman.analytics.rhythm",
      "requiredMetrics": [
        "soc.percent",
        "external-connected"
      ]
    },
