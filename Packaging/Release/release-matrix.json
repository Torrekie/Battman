  "perPluginCandidates": {
    "transport": "<plugin-identifier>.battman directory package before channel archiving",
    "transportArchive": "<plugin-identifier>_<plugin-version>.battman.zip containing the canonical <plugin-identifier>.battman directory",
    "rootedDebian": "<plugin-identifier>_<version>_iphoneos-arm.deb",
    "rootlessDebian": "<plugin-identifier>_<version>_iphoneos-arm64.deb",
    "selectedPluginIdentifiers": [],
